<div class="h-screen overflow-hidden text-white flex" id="player-session" phx-hook="PlayerSession" data-code={@code}>
  <%= if @role == :spectator do %>
    <!-- Spectator View - Full Screen Join Game -->
    <div class="flex-1 flex items-center justify-center p-8 overflow-y-auto">
      <div class="max-w-4xl w-full phase-enter">
        <%= if @show_rejoin do %>
          <div class="mb-8 p-8 bg-gradient-to-r from-blue-600 to-blue-800 rounded-3xl shadow-2xl border-4 border-blue-400">
            <h2 class="font-black mb-6 text-3xl text-center text-yellow-300">🔄 Rejoin Game</h2>
            <p class="mb-6 text-xl text-center">Select your player to continue:</p>
            <div class="space-y-3">
              <%= for {id, info} <- @players do %>
                <%= if not info.connected do %>
                  <button
                    phx-click="rejoin_game"
                    phx-value-player_id={id}
                    class="w-full text-left bg-white hover:bg-yellow-300 text-gray-900 px-6 py-4 rounded-2xl text-xl font-bold transition-all transform hover:scale-105 shadow-lg">
                    <%= info.name %>
                    <%= if id == @host_id, do: " 👑 (Host)" %>
                    - <%= info.points %> pts
                    <span class="text-red-600 ml-2">(Disconnected)</span>
                  </button>
                <% end %>
              <% end %>
            </div>
          </div>
        <% end %>

        <div class="p-8 bg-gradient-to-r from-purple-600 to-purple-800 rounded-3xl shadow-2xl border-4 border-purple-400">
          <div class="bg-gradient-to-r from-yellow-400 via-red-500 to-pink-500 py-6 rounded-2xl mb-6">
            <h1 class="font-logo text-6xl text-center text-white drop-shadow-lg tracking-wider">
              Willy 10
            </h1>
            <p class="mt-2 text-center text-2xl font-black text-white/90 tracking-[0.4em]">
              Lobby <%= @code %>
            </p>
          </div>
          <h2 class="font-black mb-6 text-3xl text-center text-yellow-300">
            <%= if @show_rejoin, do: "Or Join as New Player", else: "Join the Game!" %>
          </h2>
          <.form :let={_f} for={%{}} phx-submit="join_game">
            <input
              name="nickname"
              type="text"
              placeholder="Enter your nickname"
              required
              class="mb-6 block w-full rounded-2xl border-4 border-yellow-400 px-6 py-4 text-2xl font-bold text-gray-900 shadow-lg focus:outline-none focus:ring-4 focus:ring-yellow-300"
            />
            <div class="flex gap-4">
              <button
                name="as"
                value="player"
                class="flex-1 bg-gradient-to-r from-green-500 to-green-700 hover:from-green-600 hover:to-green-800 text-white px-8 py-4 rounded-2xl text-2xl font-black shadow-xl transform hover:scale-105 transition-all">
                🎮 Join as Player
              </button>
              <%= if is_nil(@host_id) do %>
                <button
                  name="as"
                  value="host"
                  class="flex-1 bg-gradient-to-r from-yellow-500 to-orange-600 hover:from-yellow-600 hover:to-orange-700 text-white px-8 py-4 rounded-2xl text-2xl font-black shadow-xl transform hover:scale-105 transition-all">
                  👑 Join as Host
                </button>
              <% end %>
            </div>
          </.form>
        </div>
      </div>
    </div>
  <% else %>
    <!-- Main Game View with Sidebar -->

    <!-- Sidebar -->
    <div class="w-80 bg-gradient-to-b from-purple-900 via-blue-900 to-indigo-900 border-r-4 border-yellow-400 flex flex-col">
      <!-- Header -->
      <div class="shrink-0 bg-gradient-to-r from-yellow-400 via-red-500 to-pink-500 py-4 px-4 shadow-2xl">
        <h1 class="font-logo text-4xl text-center text-white drop-shadow-lg tracking-wide">
          Willy 10
        </h1>
        <p class="mt-1 text-center text-sm font-black text-white/90 tracking-[0.4em]">
          Lobby <%= @code %>
        </p>
      </div>

      <!-- Invite (visible to everyone while waiting) -->
      <%= if @game_status == :waiting do %>
        <div class="shrink-0 p-4 bg-white/10 border-b-4 border-yellow-400 text-center">
          <div class="text-xs font-bold text-yellow-200 uppercase tracking-wide mb-1">Invite your friends</div>
          <div class="text-4xl font-black tracking-[0.3em] text-yellow-300 mb-2"><%= @code %></div>
          <button
            id="copy-invite-link"
            phx-hook="CopyToClipboard"
            data-value={@join_url}
            class="w-full bg-blue-600 hover:bg-blue-700 text-white px-3 py-2 rounded-xl text-sm font-bold shadow-lg transition-all">
            📋 Copy invite link
          </button>
        </div>
      <% end %>

      <!-- Host Control Panel -->
      <%= if @role == :host do %>
        <div class="shrink-0 p-4 bg-gradient-to-r from-yellow-600 to-orange-600 border-b-4 border-yellow-400">
          <div class="flex items-center gap-3 mb-3">
            <span class="text-3xl">👑</span>
            <div>
              <h3 class="text-xl font-black text-white">Host</h3>
              <p class="text-sm text-yellow-100"><%= @nickname %></p>
            </div>
          </div>

          <%= if @game_status == :waiting do %>
            <div class="mb-3">
              <label class="text-white font-bold text-sm block mb-1">Timer:</label>
              <form phx-change="update_timer_setting">
                <select
                  name="value"
                  class="w-full px-3 py-2 rounded-xl font-bold text-gray-900 bg-white border-2 border-yellow-400">
                  <option value="30" selected={@timer_setting == 30}>30s</option>
                  <option value="45" selected={@timer_setting == 45}>45s</option>
                  <option value="60" selected={@timer_setting == 60}>60s</option>
                  <option value="90" selected={@timer_setting == 90}>90s</option>
                  <option value="120" selected={@timer_setting == 120}>2min</option>
                </select>
              </form>
            </div>

            <div class="mb-3">
              <label class="text-white font-bold text-sm block mb-1">Rounds per player:</label>
              <form phx-change="set_rounds">
                <select
                  name="value"
                  class="w-full px-3 py-2 rounded-xl font-bold text-gray-900 bg-white border-2 border-yellow-400">
                  <option value="1" selected={@rounds_setting == 1}>1 round</option>
                  <option value="2" selected={@rounds_setting == 2}>2 rounds</option>
                  <option value="3" selected={@rounds_setting == 3}>3 rounds</option>
                </select>
              </form>
            </div>
          <% end %>

          <form phx-submit="end_session" phx-hook="ConfirmClose" id="close-game-form">
            <button class="w-full bg-red-600 hover:bg-red-700 text-white px-3 py-2 rounded-xl text-sm font-bold shadow-lg transition-all" type="submit">
              🚫 Close Lobby
            </button>
          </form>
        </div>
      <% end %>

      <!-- Timer Display -->
      <%= if @game_status == :in_progress and @current_phase == :guessing do %>
        <div class="shrink-0 p-4 bg-gradient-to-r from-red-600 to-red-800 border-b-4 border-red-400">
          <div class="text-center">
            <div class={[
              "text-6xl font-black tabular-nums",
              @timer_state == :running && @time_remaining <= 10 && "animate-pulse text-yellow-300",
              @timer_state == :running && @time_remaining > 10 && "text-white",
              @timer_state == :paused && "text-orange-300",
              @timer_state == :stopped && "text-gray-300"
            ]}>
              <%= @time_remaining %>
            </div>
            <div class="text-sm font-bold text-white">seconds</div>
          </div>

          <%= if @role == :host do %>
            <div class="mt-3 flex gap-2">
              <%= case @timer_state do %>
                <% :stopped -> %>
                  <button
                    phx-click="start_timer"
                    class="flex-1 bg-green-600 hover:bg-green-700 text-white px-3 py-2 rounded-xl text-sm font-black shadow-xl transition-all">
                    ▶️ Start
                  </button>
                <% :running -> %>
                  <button
                    phx-click="pause_timer"
                    class="flex-1 bg-yellow-600 hover:bg-yellow-700 text-white px-3 py-2 rounded-xl text-sm font-black shadow-xl transition-all">
                    ⏸️ Pause
                  </button>
                <% :paused -> %>
                  <button
                    phx-click="start_timer"
                    class="flex-1 bg-green-600 hover:bg-green-700 text-white px-3 py-2 rounded-xl text-sm font-black shadow-xl transition-all">
                    ▶️ Resume
                  </button>
              <% end %>
              <button
                phx-click="reset_timer"
                class="flex-1 bg-gray-600 hover:bg-gray-700 text-white px-3 py-2 rounded-xl text-sm font-black shadow-xl transition-all">
                🔄 Reset
              </button>
            </div>
          <% end %>
        </div>
      <% end %>

      <!-- Players Section -->
      <div class="flex-1 min-h-0 p-4 overflow-y-auto">
        <div class="mb-3 flex justify-between items-center">
          <h2 class="text-2xl font-black text-yellow-300">🎯 Players</h2>
          <%= if @role != :host do %>
            <form phx-submit="leave_game">
              <button class="bg-red-600 hover:bg-red-700 text-white px-3 py-2 rounded-xl text-xs font-bold shadow-lg transition-all" type="submit">
                🚪 Leave
              </button>
            </form>
          <% end %>
        </div>
        <div class="space-y-2">
          <%= for {id, info} <- @players do %>
            <%= if id != @host_id do %>
              <% is_guessing = @current_phase == :guessing and id == @current_guessing_player %>
              <div class={[
                "px-4 py-3 rounded-xl text-sm font-bold relative group transition-all shadow-lg",
                info.connected && not is_guessing && "bg-gradient-to-r from-blue-500 to-blue-700 border-2 border-blue-300",
                info.connected && is_guessing && "bg-gradient-to-r from-green-500 to-emerald-700 border-2 border-green-300 guessing-glow",
                not info.connected && "bg-gray-600 border-2 border-gray-400",
                info.state == :active_player && "ring-2 ring-yellow-400"
              ]}>
                <div class="flex justify-between items-center">
                  <div>
                    <%= info.name %>
                    <%= if id == @player_id, do: " (You)" %>
                    <%= if info.state == :active_player, do: " ⭐" %>
                    <%= if is_guessing, do: " 🎯" %>
                    <%= if not info.connected do %>
                      <span class="ml-1 text-red-300 text-xs">(Offline)</span>
                    <% end %>
                  </div>
                  <%= if @role == :host do %>
                    <div class="flex items-center gap-1">
                      <button
                        phx-click="adjust_points"
                        phx-value-player_id={id}
                        phx-value-delta="-1"
                        class="w-6 h-6 rounded-full bg-black/30 hover:bg-red-600 text-white font-black text-xs flex items-center justify-center transition-colors"
                        title="Subtract a point">
                        −
                      </button>
                      <span class="font-black text-yellow-300 min-w-[3.5rem] text-center"><%= info.points %> pts</span>
                      <button
                        phx-click="adjust_points"
                        phx-value-player_id={id}
                        phx-value-delta="1"
                        class="w-6 h-6 rounded-full bg-black/30 hover:bg-green-600 text-white font-black text-xs flex items-center justify-center transition-colors"
                        title="Add a point">
                        +
                      </button>
                    </div>
                  <% else %>
                    <span class="font-black text-yellow-300"><%= info.points %> pts</span>
                  <% end %>
                </div>
                <%= if @role == :host do %>
                  <button
                    phx-click="remove_player"
                    phx-value-player_id={id}
                    phx-value-player_name={info.name}
                    class="absolute top-1 right-1 text-red-300 hover:text-red-100 font-black opacity-0 group-hover:opacity-100 transition-opacity text-xs"
                    title="Remove player">
                    ✕
                  </button>
                <% end %>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>

      <!-- Host Controls (Bottom) -->
      <%= if @role == :host and @game_status == :in_progress do %>
        <div class="shrink-0 p-4 bg-white/10 border-t-4 border-yellow-400">
          <div class="space-y-2">
            <%= if @current_phase == :guessing do %>
              <div class="flex gap-2">
                <button
                  phx-click="previous_guessing_player"
                  class="flex-1 bg-gray-600 hover:bg-gray-700 text-white px-3 py-2 rounded-xl text-xs font-black shadow-xl transition-all">
                  ⬅️ Prev
                </button>
                <button
                  phx-click="next_guessing_player"
                  class="flex-1 bg-blue-600 hover:bg-blue-700 text-white px-3 py-2 rounded-xl text-xs font-black shadow-xl transition-all">
                  Next ➡️
                </button>
              </div>
            <% end %>
            <%= if @current_phase == :revealing do %>
              <button
                phx-click="reveal_all_words"
                class="w-full bg-purple-600 hover:bg-purple-700 text-white px-3 py-2 rounded-xl text-xs font-black shadow-xl transition-all">
                🎉 Reveal All
              </button>
            <% end %>
            <%= if @current_phase != :guessing do %>
              <%= if @current_phase != :choose do %>
                <button
                  phx-click="previous_phase"
                  class="w-full bg-gray-600 hover:bg-gray-700 text-white px-3 py-2 rounded-xl text-xs font-black shadow-xl transition-all">
                  ⬅️ Previous Phase
                </button>
              <% end %>
              <button
                phx-click="next_phase"
                class="w-full bg-green-600 hover:bg-green-700 text-white px-3 py-2 rounded-xl text-xs font-black shadow-xl transition-all">
                <%= if @current_phase == :choose, do: "Next Phase ➡️", else: "Next Round ➡️" %>
              </button>
            <% end %>
          </div>
        </div>
      <% end %>

      <!-- Start Game Button (Waiting) -->
      <%= if @role == :host and @game_status == :waiting do %>
        <div class="shrink-0 p-4 bg-white/10 border-t-4 border-yellow-400">
          <form phx-submit="start_game">
            <button
              class="w-full bg-gradient-to-r from-green-500 to-green-700 hover:from-green-600 hover:to-green-800 text-white px-4 py-3 rounded-2xl text-lg font-black shadow-2xl disabled:opacity-50 disabled:cursor-not-allowed transition-all"
              disabled={map_size(@players) < @min_players_total}>
              🚀 Start Game
            </button>
            <p class="mt-2 text-xs text-center font-bold text-yellow-300">
              <%= if map_size(@players) < @min_players_total do %>
                Need <%= @min_players_total - map_size(@players) %> more
              <% else %>
                Ready! (<%= map_size(@players) - 1 %> players)
              <% end %>
            </p>
          </form>
        </div>
      <% end %>
    </div>

    <!-- Main Frame -->
    <div class="flex-1 bg-gradient-to-br from-purple-900 via-blue-900 to-indigo-900 overflow-y-auto">
      <div id={"phase-view-#{@game_status}-#{@current_phase}"} class="container mx-auto px-8 py-8 phase-enter">
        <!-- Game Status + Main Word (side by side) -->
        <%= if @game_status == :in_progress do %>
          <div class="mb-8 flex flex-wrap items-stretch justify-center gap-6">
            <div
              id={"phase-banner-#{@current_phase}-#{@current_guessing_player}"}
              class={[
                "px-10 py-6 rounded-3xl shadow-2xl border-4 banner-pop text-center flex flex-col justify-center",
                @current_phase == :choose && "bg-gradient-to-r from-sky-600 to-blue-700 border-sky-400",
                @current_phase == :guessing && "bg-gradient-to-r from-emerald-600 to-teal-700 border-emerald-400",
                @current_phase == :revealing && "bg-gradient-to-r from-pink-600 to-purple-600 border-pink-400"
              ]}>
              <h2 class="text-4xl font-black mb-2">Round <%= @current_round %><%= if @total_rounds > 0 do %> / <%= @total_rounds %><% end %></h2>
              <p class="text-2xl font-bold text-yellow-300">
                <%= case @current_phase do %>
                  <% :choose -> %>
                    📝 Choose Phase
                  <% :guessing -> %>
                    🎯 Guessing Phase
                    <%= if @current_guessing_player do %>
                      <%= if @current_guessing_player == @player_id do %>
                        <span class="block mt-2 text-3xl text-white drop-shadow-lg">
                          It's YOUR turn to guess!
                        </span>
                      <% else %>
                        <span class="block mt-2 text-3xl">
                          <%= @players[@current_guessing_player].name %> is guessing!
                        </span>
                      <% end %>
                    <% end %>
                  <% :revealing -> %>
                    🎉 Revealing Phase
                <% end %>
              </p>
            </div>

            <%= if @main_word != "" do %>
              <%= if @role == :host or @player_state == :active_player or
                  (@current_phase == :revealing) or
                  (@current_phase == :guessing and @current_guessing_player == @player_id and @timer_state == :running) do %>
                <div id="main-word-visible" class="banner-pop max-w-2xl px-10 py-6 bg-gradient-to-r from-yellow-400 via-orange-500 to-red-500 rounded-3xl shadow-2xl border-4 border-yellow-300 flex items-center justify-center">
                  <div class={["font-black text-white drop-shadow-2xl tracking-wider break-words text-center", main_word_size_class(@main_word)]}>
                    <%= @main_word %>
                  </div>
                </div>
              <% else %>
                <%= if @current_phase == :guessing and @current_guessing_player == @player_id do %>
                  <div id="main-word-your-turn" class="banner-pop max-w-2xl px-10 py-6 bg-gradient-to-r from-green-600 to-emerald-700 rounded-3xl shadow-2xl border-4 border-green-400 flex items-center justify-center">
                    <div class="text-2xl md:text-3xl font-black text-white drop-shadow-lg text-center">
                      🎯 Your turn! Wait for the host to start the timer...
                    </div>
                  </div>
                <% else %>
                  <div id="main-word-locked" class="banner-pop max-w-2xl px-10 py-6 bg-gradient-to-r from-gray-600 to-gray-800 rounded-3xl shadow-2xl border-4 border-gray-500 flex items-center justify-center">
                    <div class="text-2xl md:text-3xl font-black text-gray-400 text-center">
                      🔒 Waiting for your turn...
                    </div>
                  </div>
                <% end %>
              <% end %>
            <% end %>
          </div>
        <% end %>

        <!-- Main Word Input (for host during choose phase) -->
        <%= if @role == :host and @current_phase == :choose do %>
          <div class="mb-8 max-w-4xl mx-auto">
            <label class="block text-2xl font-black text-yellow-300 mb-4 text-center">
              📌 Enter Main Word
            </label>
            <input
              type="text"
              value={@main_word}
              phx-keyup="update_main_word"
              class="block w-full rounded-2xl border-4 border-yellow-400 shadow-xl text-4xl py-6 px-8 font-black text-gray-900 text-center focus:outline-none focus:ring-4 focus:ring-yellow-300"
              placeholder="Enter the main word"
            />
          </div>
        <% end %>

        <!-- Guess Words Input -->
        <%= if (@role == :host or (@game_status == :in_progress and @player_state == :active_player)) and @current_phase == :choose do %>
          <div class="mb-8 max-w-4xl mx-auto">
            <label class="block text-2xl font-black text-yellow-300 mb-4 text-center">
              ✍️ Add Guess Words (<%= length(@guess_words) %>/<%= @max_guess_words %>)
            </label>
            <.form :let={_f} for={%{}} phx-submit="add_guess_word" phx-trigger-action={false}>
              <input
                type="text"
                id="new-guess-word"
                name="value"
                phx-keydown="add_guess_word"
                phx-value-submit=""
                class="block w-full rounded-2xl border-4 border-blue-400 shadow-xl text-2xl py-4 px-6 font-bold text-gray-900 focus:outline-none focus:ring-4 focus:ring-blue-300"
                placeholder="Type a word and press Enter"
                disabled={length(@guess_words) >= @max_guess_words}
              />
            </.form>
          </div>
        <% end %>

        <!-- Guess Words Grid with Flip Animation -->
        <div class="mb-8">
          <h3 class="text-3xl font-black text-yellow-300 mb-6 text-center">
            🎴 Word Cards
          </h3>
          <div class="grid grid-cols-2 md:grid-cols-5 gap-4 max-w-6xl mx-auto">
            <%= for {word, index} <- Enum.with_index(Enum.concat(@guess_words, List.duplicate(nil, @max_guess_words - length(@guess_words)))) do %>
              <% can_see_word = @role == :host or @player_state == :active_player %>
              <% clickable = not is_nil(word) and ((@current_phase == :guessing and can_see_word) or (@current_phase == :revealing and @role == :host)) %>
              <% found = @current_phase == :guessing and index in Map.get(@found_words, @current_guessing_player, []) %>
              <div
                class="perspective-1000 card-deal"
                style={"animation-delay: #{index * 60}ms"}
                phx-click={cond do
                  @current_phase == :guessing and can_see_word -> "toggle_found_word"
                  @current_phase == :revealing and @role == :host -> "reveal_word"
                  true -> nil
                end}
                phx-value-index={index}>
                <div class={[
                  "relative h-48 w-full card-flip transform-style-3d",
                  @current_phase == :revealing and index in @revealed_words and "rotate-y-180",
                  clickable and "cursor-pointer"
                ]}>
                  <!-- Front of card -->
                  <%= cond do %>
                    <% is_nil(word) -> %>
                      <!-- Empty slot -->
                      <div class="absolute inset-0 backface-hidden rounded-2xl border-2 border-dashed border-white/20 bg-white/5 flex items-center justify-center">
                        <span class="text-3xl font-black text-white/20"><%= index + 1 %></span>
                      </div>
                    <% can_see_word -> %>
                      <!-- Word face for host / active player -->
                      <div class={[
                        "absolute inset-0 backface-hidden rounded-2xl shadow-xl flex items-center justify-center p-4 border-4 transition-all duration-300",
                        clickable and "hover:scale-105 hover:shadow-2xl",
                        found && "bg-gradient-to-br from-green-400 to-emerald-600 border-green-300 shadow-green-500/40",
                        !found && "bg-gradient-to-br from-indigo-500 to-violet-700 border-indigo-300"
                      ]}>
                        <%= if found do %>
                          <span class="absolute top-2 left-2 w-8 h-8 rounded-full bg-white/90 text-green-600 flex items-center justify-center text-xl font-black shadow-lg">
                            ✓
                          </span>
                        <% end %>
                        <span class={["font-black text-white text-center break-words max-w-full drop-shadow", text_size_class(word)]}>
                          <%= word %>
                        </span>
                        <%= if @current_phase == :choose do %>
                          <button
                            type="button"
                            phx-click="remove_guess_word"
                            phx-value-index={index}
                            class="absolute top-2 right-2 text-white hover:text-red-200 text-xl font-black bg-red-600 hover:bg-red-700 rounded-full w-8 h-8 flex items-center justify-center shadow-lg transition-colors"
                            title="Remove">
                            ✕
                          </button>
                        <% end %>
                      </div>
                    <% true -> %>
                      <!-- Decorative card back for guessers -->
                      <div class="card-back absolute inset-0 backface-hidden rounded-2xl shadow-xl border-4 border-indigo-100/90 flex items-center justify-center overflow-hidden">
                        <div class="w-16 h-16 rotate-45 rounded-lg bg-gradient-to-br from-yellow-300 via-amber-400 to-orange-500 border-2 border-yellow-200/80 shadow-xl flex items-center justify-center">
                          <span class="-rotate-45 text-3xl font-black text-indigo-900">?</span>
                        </div>
                      </div>
                  <% end %>

                  <!-- Back of card (revealed) - Only shows after flip -->
                  <%= if @current_phase == :revealing and index in @revealed_words do %>
                    <div class="reveal-shine absolute inset-0 backface-hidden rotate-y-180 rounded-2xl shadow-2xl bg-gradient-to-br from-yellow-300 via-amber-400 to-orange-500 border-4 border-yellow-200 flex flex-col items-center justify-center p-4 overflow-hidden">
                      <span class={["font-black text-gray-900 text-center break-words max-w-full", text_size_class(word)]}>
                        <%= word %>
                      </span>
                      <%= if Map.get(@word_guesses, index, []) != [] do %>
                        <div class="mt-3 text-center">
                          <div class="text-xs font-black uppercase tracking-wide text-orange-900/70 mb-1">Found by</div>
                          <div class="flex flex-wrap justify-center gap-1">
                            <%= for player_id <- Map.get(@word_guesses, index, []) do %>
                              <span class="px-2 py-0.5 rounded-full bg-white/70 text-blue-900 text-xs font-bold shadow">
                                <%= @players[player_id].name %>
                              </span>
                            <% end %>
                          </div>
                        </div>
                      <% end %>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <!-- Your Turn Overlay -->
    <%= if @game_status == :in_progress and @current_phase == :guessing and @current_guessing_player == @player_id do %>
      <div id="your-turn-frame" class="your-turn-frame"></div>
      <div id="your-turn-banner" class="your-turn-banner">
        <div class="flex items-center gap-3 bg-gradient-to-r from-green-500 to-emerald-600 border-4 border-green-300 text-white text-2xl font-black px-8 py-3 rounded-full shadow-2xl">
          <span class="text-3xl">🎯</span> Your turn — find the words!
        </div>
      </div>
    <% end %>

    <!-- Game Over Modal -->
    <%= if @game_status == :finished do %>
      <div id="game-over-backdrop" class="fade-in fixed inset-0 bg-black/80 flex items-center justify-center z-50 p-4">
        <div id="game-over-modal" class="banner-pop bg-gradient-to-br from-purple-600 to-pink-600 p-8 rounded-3xl shadow-2xl max-w-2xl w-full border-4 border-yellow-400">
          <h2 class="text-5xl font-black mb-8 text-center text-yellow-300 drop-shadow-lg">
            🏆 Game Over! 🏆
          </h2>
          <div class="space-y-4 mb-8">
            <%= for {{player_id, points}, rank} <- Enum.with_index(Enum.reject(@rankings, fn {id, _} -> id == @host_id end), 1) do %>
              <div class={[
                "flex items-center justify-between p-6 rounded-2xl shadow-lg",
                rank == 1 && "bg-gradient-to-r from-yellow-400 to-yellow-600 border-4 border-yellow-300 scale-105",
                rank == 2 && "bg-gradient-to-r from-gray-300 to-gray-500",
                rank == 3 && "bg-gradient-to-r from-orange-400 to-orange-600",
                rank > 3 && "bg-white/20"
              ]}>
                <div class="flex items-center gap-4">
                  <span class="text-4xl font-black">
                    <%= case rank do %>
                      <% 1 -> %> 🥇
                      <% 2 -> %> 🥈
                      <% 3 -> %> 🥉
                      <% _ -> %> #<%= rank %>
                    <% end %>
                  </span>
                  <div>
                    <span class={[
                      "text-2xl font-bold",
                      rank <= 3 && "text-gray-900",
                      rank > 3 && "text-white"
                    ]}>
                      <%= @players[player_id].name %>
                    </span>
                    <%= if player_id == @player_id do %>
                      <span class="ml-2 text-xl">(You)</span>
                    <% end %>
                  </div>
                </div>
                <span class={[
                  "text-3xl font-black",
                  rank <= 3 && "text-gray-900",
                  rank > 3 && "text-yellow-300"
                ]}>
                  <%= points %> pts
                </span>
              </div>
            <% end %>
          </div>
          <div class="flex gap-4 justify-center">
            <%= if @role == :host do %>
              <button
                phx-click="start_new_game"
                class="bg-green-600 hover:bg-green-700 text-white px-10 py-4 rounded-2xl text-2xl font-black shadow-xl transition-all transform hover:scale-105">
                🎮 New Game
              </button>
              <button
                phx-click="end_session"
                class="bg-red-600 hover:bg-red-700 text-white px-10 py-4 rounded-2xl text-2xl font-black shadow-xl transition-all transform hover:scale-105">
                🚫 End Session
              </button>
            <% else %>
              <button
                phx-click="leave_game"
                class="bg-blue-600 hover:bg-blue-700 text-white px-10 py-4 rounded-2xl text-2xl font-black shadow-xl transition-all transform hover:scale-105">
                🚪 Leave Game
              </button>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
