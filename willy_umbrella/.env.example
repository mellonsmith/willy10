# Copy this file to `.env` (which is git-ignored) and adjust the values.
# `.env` is loaded automatically in config/runtime.exs for every environment;
# real environment variables always take precedence over the file.
#
# The public URL below is used BOTH to serve the app and to build the
# shareable lobby links (e.g. https://PHX_HOST/g/ABCD).

# Host the app is reached at — no scheme, no port (e.g. willy.example.com)
PHX_HOST=localhost

# Scheme used in generated links: http or https
PHX_SCHEME=http

# Port shown in generated links. In dev this matches the HTTP port (4000);
# behind TLS in production set this to 443 (with PHX_SCHEME=https).
PHX_URL_PORT=4000

# --- Production-only settings (safe to leave unset in development) ---

# Port the server actually binds to.
# PORT=4000

# Secret used to sign/encrypt cookies. Generate one with: mix phx.gen.secret
# SECRET_KEY_BASE=

# Optional libcluster DNS query for clustering.
# DNS_CLUSTER_QUERY=
